<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="jokes.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="1"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1612"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="inform_sys" custom_title="0" dock_id="4" table="4,10:maininform_sys"/><dock_state state=""/><default_encoding codec=""/><browse_table_settings><table schema="main" name="anecdote" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="35"/><column index="2" value="300"/><column index="3" value="63"/><column index="4" value="215"/><column index="5" value="73"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="inform_sys" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="82"/><column index="2" value="67"/><column index="3" value="300"/><column index="4" value="114"/><column index="5" value="215"/><column index="6" value="73"/><column index="7" value="78"/><column index="8" value="39"/><column index="9" value="127"/><column index="10" value="87"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">CREATE TABLE inform_sys AS
SELECT 
    'anecdote' as source_table,
    id as original_id,
    content,
    author_id as author_or_user_id,
    publication_date,
    likes_count,
    NULL as anecdote_id,
    NULL as value,
    NULL as email,
    NULL as username
FROM anecdote
UNION ALL
SELECT 
    'favorite' as source_table,
    id as original_id,
    NULL as content,
    user_id as author_or_user_id,
    NULL as publication_date,
    NULL as likes_count,
    anecdote_id,
    NULL as value,
    NULL as email,
    NULL as username
FROM favorite
UNION ALL
SELECT 
    'rating' as source_table,
    id as original_id,
    NULL as content,
    user_id as author_or_user_id,
    NULL as publication_date,
    NULL as likes_count,
    anecdote_id,
    value,
    NULL as email,
    NULL as username
FROM rating
UNION ALL
SELECT 
    'user' as source_table,
    id as original_id,
    NULL as content,
    id as author_or_user_id,
    NULL as publication_date,
    NULL as likes_count,
    NULL as anecdote_id,
    NULL as value,
    email,
    username
FROM &quot;user&quot;;</sql><current_tab id="0"/></tab_sql></sqlb_project>
